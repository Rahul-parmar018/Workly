<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_bg_gradient">

    <!-- Top Text -->
    <TextView
        android:id="@+id/tvSelectRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="Choose Your Role"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSelectRoleDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select who you are to continue"
        android:textColor="#E0E0E0"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectRole" />

    <!-- Center Hero Area for 3D characters -->
    <ImageView
        android:id="@+id/ivHeroAvatars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:scaleType="centerInside"
        android:src="@drawable/user_pfp"
        app:layout_constraintTop_toBottomOf="@id/tvSelectRoleDesc"
        app:layout_constraintBottom_toTopOf="@id/roleSelectionContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Role Selection Buttons (Circular) -->
    <LinearLayout
        android:id="@+id/roleSelectionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- User Role Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="20dp">
            
            <ImageView
                android:id="@+id/btnUser"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_black_transparent"
                android:src="@drawable/user_pfp"
                android:padding="20dp"
                android:scaleType="centerCrop"
                android:elevation="8dp" 
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- Provider Role Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="20dp">
            
            <ImageView
                android:id="@+id/btnProvider"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_black_transparent"
                android:src="@drawable/user_pfp"
                android:padding="20dp"
                android:scaleType="centerCrop"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Provider"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="40dp"
        android:text="Because your day deserves better."
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:fontFamily="sans-serif-black"
        android:lineSpacingExtra="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
